generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum Level {
  SSC
  HSC
}

enum PaymentMethod {
  BKASH
  NAGAD
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
}

model User {
  id              String           @id @default(cuid())
  name            String
  fatherName      String           @map("father_name")
  district        String
  upazila         String
  institution     String
  email           String           @unique
  phone           String
  facebookUrl     String           @map("facebook_url")
  passwordHash    String           @map("password_hash")
  role            Role             @default(STUDENT)
  isSuspended     Boolean          @default(false) @map("is_suspended")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  enrollments     Enrollment[]
  examSubmissions ExamSubmission[]

  @@map("users")
}

model Course {
  id              String       @id
  level           Level
  title           String
  subtitle        String
  subjects        String[]
  services        String[]
  price           Int
  oldPrice        Int          @map("old_price")
  privateGroupUrl String       @map("private_group_url")
  thumbnailUrl    String?      @map("thumbnail_url")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")
  enrollments     Enrollment[]
  exams           Exam[]

  @@map("courses")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  courseId        String           @map("course_id")
  paymentMethod   PaymentMethod    @map("payment_method")
  senderNumber    String           @map("sender_number")
  transactionId   String           @unique @map("transaction_id")
  amount          Int
  status          EnrollmentStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason")
  verifiedBy      String?          @map("verified_by")
  verifiedAt      DateTime?        @map("verified_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model Exam {
  id              String           @id @default(cuid())
  courseId        String?          @map("course_id")
  title           String
  description     String?          @db.Text
  durationMinutes Int              @map("duration_minutes")
  totalMarks      Float            @default(0) @map("total_marks")
  passMarks       Float            @default(0) @map("pass_marks")
  negativeMarking Float            @default(0.25) @map("negative_marking")
  isPublic        Boolean          @default(false) @map("is_public")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions   ExamQuestion[]
  submissions ExamSubmission[]

  @@index([courseId])
  @@index([isActive])
  @@map("exams")
}

model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String   @map("exam_id")
  question      String   @db.Text
  options       String[]
  correctOption Int      @map("correct_option")
  explanation   String?  @db.Text
  marks         Float    @default(1.0)
  orderIndex    Int      @default(0) @map("order_index")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, orderIndex])
  @@map("exam_questions")
}

model ExamSubmission {
  id               String               @id @default(cuid())
  examId           String               @map("exam_id")
  userId           String               @map("user_id")
  status           ExamSubmissionStatus @default(IN_PROGRESS)
  answers          Json                 @default("{}")
  totalScore       Float                @default(0) @map("total_score")
  totalQuestions   Int                  @default(0) @map("total_questions")
  correctCount     Int                  @default(0) @map("correct_count")
  wrongCount       Int                  @default(0) @map("wrong_count")
  unattemptedCount Int                  @default(0) @map("unattempted_count")
  timeTakenSeconds Int                  @default(0) @map("time_taken_seconds")
  startedAt        DateTime             @default(now()) @map("started_at")
  submittedAt      DateTime?            @map("submitted_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([examId, status, totalScore, timeTakenSeconds])
  @@map("exam_submissions")
}
