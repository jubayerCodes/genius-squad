# ==============================================================================
# Genius Squad - Server Environment Configuration (Vercel / Production / Local)
# ==============================================================================

# Server Runtime Environment
PORT=5000
NODE_ENV=production

# Frontend Application Origin (For CORS access control)
# Set to your deployed frontend domain on Vercel
CLIENT_URL="https://your-frontend-project.vercel.app"

# Neon PostgreSQL Connection Pooler URL (PgBouncer enabled, port 6543)
# Recommended for Vercel Serverless Functions to prevent connection exhaustion
DATABASE_URL="postgresql://genius_owner:secret@ep-bold-glade-123456-pooler.us-east-2.aws.neon.tech/genius_squad?sslmode=require&pgbouncer=true"

# Neon PostgreSQL Direct Connection URL (port 5432)
# Used by Prisma CLI for migrations and schema pushing
DIRECT_URL="postgresql://genius_owner:secret@ep-bold-glade-123456.us-east-2.aws.neon.tech/genius_squad?sslmode=require"

# JWT Authentication
# Generate a cryptographically secure random secret string (e.g., openssl rand -hex 32)
JWT_SECRET="genius_squad_production_super_secret_jwt_key_2026_xyz"
JWT_EXPIRES_IN="7d"
