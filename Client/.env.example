# ==============================================================================
# Genius Squad - Frontend Next.js Environment Configuration (Vercel / Local)
# ==============================================================================

# Backend Server URL (used by Next.js server-side rewrites for /api/* & /uploads/*)
# Local development default: http://localhost:5000
# Vercel production: https://your-backend-project.vercel.app
BACKEND_URL="http://localhost:5000"

# (Optional) Direct Backend API URL for client-side fetches
# When left empty, client-side requests default to same-origin (/api/v1/...) via Next.js proxy rewrites
# NEXT_PUBLIC_API_URL="https://your-backend-project.vercel.app"
