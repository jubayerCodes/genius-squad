# ==========================================
# Genius Squad - Root Git Ignore Configuration
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Whitelist environment example templates
!.env.example
!.env.*.example

# Production Builds & Compilations
dist/
build/
.next/
out/
.vercel/
*.tsbuildinfo

# Uploads
uploads/*
!uploads/.gitkeep

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime & Operating System Cache
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cache & Temporary Directories
.cache/
.temp/
.tmp/
.tmp-*
.turbo/
.claude-replay.*
/.plugins/
/.opencode-skills/
/.figma/design-context/

# Graphify Artifacts
# Commit ONLY the knowledge graph data and audit report
graphify-out/*
graphify-out/.*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
